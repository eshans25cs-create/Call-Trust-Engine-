# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: verified Gemini Live bidirectional streaming model
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-latest

# Voice Persona: Puck, Charon, Kore, Fenrir, Aoede
GEMINI_VOICE_NAME=Aoede

# System Persona / Role
AGENT_NAME=Aria
AGENT_ROLE="real-time voice assistant"

# Telephony Configuration (Optional - for Twilio Media Streams gateway)
TELEPHONY_HOST=0.0.0.0
TELEPHONY_PORT=8000
PUBLIC_BASE_URL=https://your-domain-or-ngrok.ngrok-free.app

# Audio Parameters
INPUT_SAMPLE_RATE=16000
OUTPUT_SAMPLE_RATE=24000
TELEPHONY_SAMPLE_RATE=8000
VAD_ENERGY_THRESHOLD=0.015
VAD_SILENCE_DURATION_MS=600
